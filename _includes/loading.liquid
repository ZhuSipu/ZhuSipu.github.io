<style>
  html.page-loading [role="main"],
  html.page-loading body > footer {
    opacity: 0.86;
    filter: blur(4px);
  }

  html.page-revealing [role="main"],
  html.page-revealing body > footer {
    animation: page-materialize 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes page-materialize {
    from { opacity: 0.86; filter: blur(4px); }
    to { opacity: 1; filter: blur(0); }
  }

  [data-image-surface] {
    display: block;
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  picture[data-image-surface] > img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  html.loading-effects [data-image-surface]::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--image-preview, none) center / cover no-repeat;
    filter: blur(10px);
    transform: scale(1.04);
    opacity: 1;
    transition: opacity 0.18s ease;
    pointer-events: none;
  }

  html.loading-effects [data-image-surface][data-image-settled]::before {
    opacity: 0;
  }

  html.loading-effects img {
    transition: opacity 0.18s ease;
  }

  html.loading-effects img[data-image-prepared] {
    transition: none;
  }

  html.loading-effects img:not([data-image-ready]),
  html.loading-effects [data-image-surface] > img[data-image-error] {
    opacity: 0;
  }

  html.loading-effects [data-image-surface] > img {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    html.page-loading [role="main"],
    html.page-loading body > footer {
      opacity: 1;
      filter: none;
    }
    html.page-revealing [role="main"],
    html.page-revealing body > footer { animation: none; }
    html.loading-effects img,
    html.loading-effects [data-image-surface]::before { transition: none !important; }
  }

  @media print {
    html.page-loading [role="main"],
    html.page-loading body > footer,
    html.page-revealing [role="main"],
    html.page-revealing body > footer {
      animation: none;
      opacity: 1;
      filter: none;
    }
    html.loading-effects img:not([data-image-ready]) { opacity: 1; }
    html.loading-effects img,
    html.loading-effects [data-image-surface]::before { transition: none !important; }
    html.loading-effects [data-image-surface]::before { content: none; }
  }
</style>
<script src="{{ '/assets/js/loading.js' | relative_url | bust_file_cache }}"></script>
