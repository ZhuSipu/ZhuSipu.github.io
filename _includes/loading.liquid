<style>
  html.page-loading body > header,
  html.page-loading [role="main"],
  html.page-loading body > footer {
    opacity: 0;
  }

  html.loading-effects [data-arrival="pending"] {
    opacity: 0;
    filter: blur(12px);
    transform: translate3d(0, 10px, 0);
  }

  html.loading-effects [data-arrival="revealing"] {
    animation: page-materialize 0.65s cubic-bezier(0.22, 1, 0.36, 1) var(--arrival-delay, 0ms) both;
    will-change: opacity, filter, transform;
  }

  html.loading-effects [data-arrival="formed"] {
    opacity: 1;
    filter: blur(0);
    transform: translate3d(0, 0, 0);
    transition: opacity 0.6s ease, filter 0.6s ease;
  }

  html.loading-effects.transition [data-arrival] {
    transition: opacity 0.6s ease, filter 0.6s ease !important;
  }

  html.page-revealing:not(.page-refining) [data-arrival="formed"] {
    opacity: 0.82;
    filter: blur(3px);
  }

  @keyframes page-materialize {
    0% { opacity: 0; filter: blur(12px); transform: translate3d(0, 10px, 0); }
    38% { opacity: 0.58; filter: blur(5px); }
    100% { opacity: 0.82; filter: blur(3px); transform: translate3d(0, 0, 0); }
  }

  [data-image-surface] {
    display: block;
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  picture[data-image-surface] > img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  html.loading-effects [data-image-surface]::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--image-preview, none) center / cover no-repeat;
    filter: blur(14px);
    transform: scale(1.08);
    opacity: 1;
    transition: opacity 1.1s ease;
    pointer-events: none;
  }

  html.loading-effects [data-image-surface][data-image-settled]::before {
    opacity: 0;
  }

  html.loading-effects img {
    transition: opacity 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  html.loading-effects img:not([data-image-ready]) {
    opacity: 0;
  }

  html.loading-effects [data-image-surface] > img {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    html.page-loading body > header,
    html.page-loading [role="main"],
    html.page-loading body > footer { opacity: 1; }
    html.loading-effects [data-arrival] {
      animation: none !important;
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
    }
    html.loading-effects img,
    html.loading-effects [data-image-surface]::before { transition: none; }
  }

  @media print {
    html.page-loading body > header,
    html.page-loading [role="main"],
    html.page-loading body > footer { opacity: 1; }
    html.loading-effects [data-arrival] {
      animation: none !important;
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
    }
    html.loading-effects img:not([data-image-ready]) { opacity: 1; }
    html.loading-effects [data-image-surface]::before { content: none; }
  }
</style>
<script src="{{ '/assets/js/loading.js' | relative_url | bust_file_cache }}"></script>
