{% assign empty_array = '' | split: ',' %}
{% assign photo_items = include.items | default: empty_array | sort: 'importance' %}

<div class="photo-gallery">
  {% if photo_items.size > 0 %}
    <div class="photo-overview" data-photo-overview>
      <div class="photo-overview-grid">
        {% for item in photo_items %}
          {% assign image_path = item.image | default: item.path %}
          {% if image_path %}
            <button
              class="photo-thumb"
              type="button"
              aria-label="Open {{ item.title | default: 'photograph' }}"
              data-photo-thumb
              data-photo-index="{{ forloop.index0 }}"
            >
              <div class="photo-thumb-image">
                {% if image_path contains '://' %}
                  {% include figure.liquid url=image_path class="photo-thumb-figure" alt=item.alt title=item.title loading="lazy" %}
                {% else %}
                  {% if image_path contains '/assets/' %}
                    {% assign resolved_image_path = image_path %}
                  {% else %}
                    {% assign resolved_image_path = '/assets/img/' | append: image_path %}
                  {% endif %}
                  {% include figure.liquid path=resolved_image_path class="photo-thumb-figure" alt=item.alt title=item.title loading="lazy" cache_bust=true %}
                {% endif %}
              </div>
            </button>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="photo-detail-view" data-photo-carousel tabindex="0" hidden>
      <button class="photo-detail-back" type="button" data-photo-back>All Photos</button>

      <div class="photo-carousel-stage">
        <button class="photo-carousel-nav photo-carousel-nav-prev" type="button" aria-label="Previous photograph" data-photo-prev>
          <span aria-hidden="true">&lsaquo;</span>
        </button>

        <div class="photo-carousel-track">
          {% for item in photo_items %}
            {% assign image_path = item.image | default: item.path %}
            {% if image_path %}
              <article
                class="photo-feature{% if forloop.first %} is-active{% endif %}"
                data-photo-slide
                aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
              >
                <div class="photo-feature-image">
                  {% if image_path contains '://' %}
                    {% include figure.liquid url=image_path class="photo-feature-figure" alt=item.alt title=item.title loading="lazy" %}
                  {% else %}
                    {% if image_path contains '/assets/' %}
                      {% assign resolved_image_path = image_path %}
                    {% else %}
                      {% assign resolved_image_path = '/assets/img/' | append: image_path %}
                    {% endif %}
                    {% include figure.liquid path=resolved_image_path class="photo-feature-figure" alt=item.alt title=item.title loading="lazy" cache_bust=true %}
                  {% endif %}
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>

        <button class="photo-carousel-nav photo-carousel-nav-next" type="button" aria-label="Next photograph" data-photo-next>
          <span aria-hidden="true">&rsaquo;</span>
        </button>
      </div>
    </div>
  {% else %}
    <div class="empty-state">
      Photography works will appear here once images are added to <code>materials/data/photography.yml</code>.
    </div>
  {% endif %}
</div>
