{% assign empty_array = '' | split: ',' %}
{% assign photo_items = include.items | default: empty_array | where_exp: 'item', 'item.image or item.path' | sort: 'importance' %}

<link rel="preload" as="script" href="{{ '/assets/js/photography.js' | relative_url | bust_file_cache }}" fetchpriority="high">
<div class="photo-gallery" data-photo-gallery>
  {% if photo_items.size > 0 %}
    <div class="photo-overview" data-photo-overview>
      <div class="photo-overview-grid">
        {% for item in photo_items %}
          {% assign image_path = item.image | default: item.path %}
          {% if image_path %}
            {% unless image_path contains '://' or image_path contains '/assets/' %}
              {% assign image_path = '/assets/img/' | append: image_path %}
            {% endunless %}
            <a
              class="photo-thumb"
              href="{{ image_path | relative_url }}"
              aria-label="Open {{ item.title | default: 'photograph' }}"
              aria-haspopup="dialog"
              aria-controls="photo-viewer"
              data-photo-thumb
              data-photo-index="{{ forloop.index0 }}"
            >
              <div class="photo-thumb-image">
                <span class="photo-thumb-overlay" aria-hidden="true">
                  <span class="photo-thumb-overlay-label">View</span>
                  <span class="photo-thumb-overlay-icon">&rsaquo;</span>
                </span>
                {% include photography_image.liquid item=item index=forloop.index0 %}
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="photo-detail-view" id="photo-viewer" data-photo-carousel role="dialog" aria-label="Photograph viewer" tabindex="-1" hidden>
      <div class="photo-carousel-stage">
        <div class="photo-carousel-track">
          {% for item in photo_items %}
            {% assign image_path = item.image | default: item.path %}
            {% if image_path %}
              <article
                class="photo-feature"
                data-photo-slide
                aria-hidden="true"
                hidden
                inert
              >
                <div class="photo-feature-shell">
                  <div class="photo-feature-topbar">
                    <button class="photo-detail-back" type="button" data-photo-back aria-label="Back to all photos">
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M19 12H6.5" />
                        <path d="M11.5 5 4.5 12l7 7" />
                      </svg>
                    </button>
                  </div>

                  <div class="photo-feature-content">
                    <div class="photo-feature-media">
                      <button class="photo-carousel-nav photo-carousel-nav-prev" type="button" aria-label="Previous photograph" data-photo-prev>
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                          <path d="M14.75 5.5 8.25 12l6.5 6.5" />
                        </svg>
                      </button>

                      <div class="photo-feature-image">
                        {% include photography_image.liquid item=item detail=true %}
                      </div>

                      <button class="photo-carousel-nav photo-carousel-nav-next" type="button" aria-label="Next photograph" data-photo-next>
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                          <path d="M9.25 5.5 15.75 12l-6.5 6.5" />
                        </svg>
                      </button>
                    </div>

                    {% capture photo_note %}
                      {% if item.description %}
                        {{ item.description }}
                      {% elsif item.location or item.year %}
                        {% if item.location %}{{ item.location }}{% endif %}{% if item.location and item.year %} · {% endif %}{% if item.year %}{{ item.year }}{% endif %}
                      {% endif %}
                    {% endcapture %}
                    {% assign photo_note = photo_note | strip %}
                    {% if photo_note != '' %}
                      <p class="photo-feature-note">{{ photo_note }}</p>
                    {% endif %}
                  </div>
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% else %}
    <div class="empty-state">
      Photography works will appear here once images are added to <code>materials/data/photography.yml</code>.
    </div>
  {% endif %}
</div>
<script async src="{{ '/assets/js/photography.js' | relative_url | bust_file_cache }}"></script>
