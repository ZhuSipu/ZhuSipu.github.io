{% assign empty_array = '' | split: ',' %}
{% assign photo_items = include.items | default: empty_array | sort: 'importance' %}

<div class="photo-gallery">
  {% if photo_items.size > 0 %}
    <div class="photo-overview" data-photo-overview>
      <div class="photo-overview-grid">
        {% for item in photo_items %}
          {% assign image_path = item.image | default: item.path %}
          {% assign thumb_path = item.thumbnail %}
          {% if image_path %}
            {% unless thumb_path %}
              {% assign image_segments = image_path | split: '/' %}
              {% assign image_filename = image_segments | last %}
              {% assign thumb_path = 'user/photography/thumbs/' | append: image_filename %}
            {% endunless %}
            <button
              class="photo-thumb"
              type="button"
              aria-label="Open {{ item.title | default: 'photograph' }}"
              data-photo-thumb
              data-photo-index="{{ forloop.index0 }}"
            >
              <div class="photo-thumb-image">
                <span class="photo-thumb-overlay" aria-hidden="true">
                  <span class="photo-thumb-overlay-label">View</span>
                  <span class="photo-thumb-overlay-icon">&rsaquo;</span>
                </span>
                {% assign thumb_loading = 'lazy' %}
                {% assign thumb_fetchpriority = nil %}
                {% if forloop.index <= 3 %}
                  {% assign thumb_loading = 'eager' %}
                  {% assign thumb_fetchpriority = 'high' %}
                {% endif %}
                {% if thumb_path contains '://' %}
                  {% include figure.liquid url=thumb_path class="photo-thumb-figure" alt=item.alt title=item.title loading=thumb_loading fetchpriority=thumb_fetchpriority sizes="(max-width: 768px) 50vw, 33vw" %}
                {% else %}
                  {% if thumb_path contains '/assets/' %}
                    {% assign resolved_thumb_path = thumb_path %}
                  {% else %}
                    {% assign resolved_thumb_path = '/assets/img/' | append: thumb_path %}
                  {% endif %}
                  {% include figure.liquid path=resolved_thumb_path class="photo-thumb-figure" alt=item.alt title=item.title loading=thumb_loading fetchpriority=thumb_fetchpriority sizes="(max-width: 768px) 50vw, 33vw" cache_bust=true %}
                {% endif %}
              </div>
            </button>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="photo-detail-view" data-photo-carousel tabindex="0" hidden>
      <div class="photo-carousel-stage">
        <button class="photo-carousel-nav photo-carousel-nav-prev" type="button" aria-label="Previous photograph" data-photo-prev>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M14.75 5.5 8.25 12l6.5 6.5" />
          </svg>
        </button>

        <div class="photo-carousel-track">
          {% for item in photo_items %}
            {% assign image_path = item.image | default: item.path %}
            {% if image_path %}
              <article
                class="photo-feature{% if forloop.first %} is-active{% endif %}"
                data-photo-slide
                aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
              >
                <div class="photo-feature-shell">
                  <div class="photo-feature-topbar">
                    <button class="photo-detail-back" type="button" data-photo-back aria-label="Back to all photos">
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M19 12H6.5" />
                        <path d="M11.5 5 4.5 12l7 7" />
                      </svg>
                    </button>
                  </div>

                  <div class="photo-feature-image">
                    {% if image_path contains '://' %}
                      {% include figure.liquid url=image_path class="photo-feature-figure" alt=item.alt title=item.title loading="lazy" sizes="100vw" %}
                    {% else %}
                      {% if image_path contains '/assets/' %}
                        {% assign resolved_image_path = image_path %}
                      {% else %}
                        {% assign resolved_image_path = '/assets/img/' | append: image_path %}
                      {% endif %}
                      {% include figure.liquid path=resolved_image_path class="photo-feature-figure" alt=item.alt title=item.title loading="lazy" sizes="100vw" cache_bust=true %}
                    {% endif %}
                  </div>

                  {% capture photo_note %}
                    {% if item.description %}
                      {{ item.description }}
                    {% elsif item.location or item.year %}
                      {% if item.location %}{{ item.location }}{% endif %}{% if item.location and item.year %} · {% endif %}{% if item.year %}{{ item.year }}{% endif %}
                    {% endif %}
                  {% endcapture %}
                  {% assign photo_note = photo_note | strip %}
                  {% if photo_note != '' %}
                    <p class="photo-feature-note">{{ photo_note }}</p>
                  {% endif %}
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>

        <button class="photo-carousel-nav photo-carousel-nav-next" type="button" aria-label="Next photograph" data-photo-next>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9.25 5.5 15.75 12l-6.5 6.5" />
          </svg>
        </button>
      </div>
    </div>
  {% else %}
    <div class="empty-state">
      Photography works will appear here once images are added to <code>materials/data/photography.yml</code>.
    </div>
  {% endif %}
</div>
