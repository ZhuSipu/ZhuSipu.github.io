<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
  </head>

  <body class="layout-blog {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <nav class="blog-navbar" aria-label="Blog navigation">
      <div class="blog-navbar-inner">
        <a class="blog-brand" href="{{ '/blog/' | relative_url }}">{{ page.blog_title | default: page.title }}</a>
        <div class="blog-nav-links">
          <a href="{{ '/blog/' | relative_url }}">Home</a>
          <a href="{{ '/' | relative_url }}">Personal Homepage</a>
          <a href="#posts">Posts</a>
        </div>
      </div>
    </nav>

    <header class="blog-masthead" style="background-image: url('{{ page.hero_image | relative_url }}')">
      <div class="blog-masthead-overlay"></div>
      <div class="blog-masthead-content">
        <h1>{{ page.blog_title | default: page.title }}</h1>
        {% if page.description %}
          <p>{{ page.description }}</p>
        {% endif %}
      </div>
    </header>

    <main class="blog-main" id="posts">
      {{ content }}
    </main>

    <footer class="blog-footer">
      <a href="{{ '/' | relative_url }}">Sipu Zhu</a>
    </footer>

    {% include scripts.liquid %}
  </body>
</html>
